OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# mem0 / Postgres: prefer Session pooler from Dashboard → Connect (IPv4). Direct db.* host is often IPv6-only.
# User must be postgres.[PROJECT-REF]. Pooler host may be aws-0- or aws-1- — always copy from the dashboard.
# URL-encode password specials (& → %26, / → %2F).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Optional override (wins over DATABASE_URL if set):
# SUPABASE_DB_CONNECTION_STRING=
SUPABASE_CAMPAIGNS_TABLE=campaigns

FRONTEND_ORIGIN=http://localhost:5173
MEM0_USER_ID_PREFIX=user
